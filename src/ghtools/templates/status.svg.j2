<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 [[ width ]] [[ height ]]" width="[[ width ]]" height="[[ height ]]">
<style>
svg { font-family: var(--fontStack-sansSerif, -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans", Helvetica, Arial, sans-serif); }
.background { fill: var(--bgColor-default, #0d1117); }
.text { fill: var(--fgColor-default, var(--color-fg-default, #f6f8fa)); }
.muted { fill: var(--color-prettylights-syntax-comment, #656d76); }
.card { fill: var(--bgColor-muted, var(--color-canvas-subtle, #151b23)); }
.mono { font-family: var(--fontStack-monospace, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace); }
.title { font-size: 2em; font-weight: 600; }
.subtitle { font-size: 16px; }
.label { font-size: 12px; font-weight: 600; letter-spacing: 0.08em; }
.value { font-size: 22px; font-weight: 500; }
.small { font-size: 13px; }
.link { fill: var(--fgColor-accent, var(--color-accent-fg, #0969da)); text-decoration: underline; }
.pass { fill: var(--bgColor-success-emphasis, #1a7f37); }
.fail { fill: var(--bgColor-danger-emphasis, #cf222e); }
.warn { fill: var(--bgColor-attention-emphasis, #9a6700); }
.ok { fill: var(--bgColor-success-emphasis, #1a7f37); }
</style>
<rect class="background" x="1" y="1" width="[[ width - 2 ]]" height="[[ height - 2 ]]" rx="14"/>
[% if logo %]
<image x="35" y="20" width="80" height="80" href="[[ logo ]]"/>
[% endif %]
<text class="title text" x="[[ text_x ]]" y="55">[[ name ]]</text>
<text class="subtitle muted" x="[[ text_x ]]" y="90">
[% for line in description_lines %]
<tspan x="[[ text_x ]]"[% if not loop.first %] dy="18"[% endif %]>[[ line ]]</tspan>
[% endfor %]
</text>
[% if version %]
<text class="value text" x="865" y="55" text-anchor="end">v[[ version ]]</text>
[% endif %]
[% for l in links %]
<a href="[[ l.url ]]"><text class="link" x="[[ l.x ]]" y="[[ links_y ]]">[[ l.text ]]</text></a>
[% endfor %]
[% if cards %]
<text class="label muted" x="35" y="[[ label_y ]]">QUALITY</text>
[% endif %]
[% for c in cards %]
<rect class="card" x="[[ c.x ]]" y="[[ c.y ]]" width="190" height="90" rx="10"/>
<text class="label mono [[ c.state ]]" x="[[ c.x + 15 ]]" y="[[ c.y + 25 ]]">[[ c.title ]]</text>
<text class="value text" x="[[ c.x + 15 ]]" y="[[ c.y + 57 ]]">[[ c.value ]]</text>
<text class="small mono muted" x="[[ c.x + 15 ]]" y="[[ c.y + 77 ]]">[[ c.detail ]]</text>
[% endfor %]
[% for p in panels %]
<text class="label muted" x="[[ p.x ]]" y="[[ p.y ]]">[[ p.label ]]</text>
[% if p.kind == "python" %]
[% for py in p["items"] %]
<text class="small text" x="[[ p.x + 10 + loop.index0 * 50 ]]" y="[[ p.y + 30 ]]" text-anchor="middle">[[ py.version ]]</text>
<circle cx="[[ p.x + 10 + loop.index0 * 50 ]]" cy="[[ p.y + 55 ]]" r="8" class="[[ 'pass' if py.status == 'passing' else 'fail' ]]"/>
[% endfor %]
[% elif p.kind == "builds" %]
[% for arch in p.archs %]
<text class="small muted" x="[[ p.x ]]" y="[[ p.y + 50 + loop.index0 * 22 ]]">[[ arch ]]</text>
[% endfor %]
[% for os_name, archs in p.oses %]
<text class="small text" x="[[ p.x + 90 + loop.index0 * 60 ]]" y="[[ p.y + 28 ]]" text-anchor="middle">[[ os_name ]]</text>
[% set col = loop.index0 %]
[% for arch in p.archs %]
[% if arch in archs %]
<circle cx="[[ p.x + 90 + col * 60 ]]" cy="[[ p.y + 46 + loop.index0 * 22 ]]" r="6" class="[[ 'pass' if archs[arch] == 'passing' else 'fail' ]]"/>
[% endif %]
[% endfor %]
[% endfor %]
[% elif p.kind == "extra" %]
[% for item in p["items"] %]
<text class="small text" x="[[ p.x + item.dx ]]" y="[[ p.y + 30 ]]">[[ item.label ]]</text>
<text class="value mono [[ p.state if loop.first else 'muted' ]]" x="[[ p.x + item.dx ]]" y="[[ p.y + 58 ]]">[[ item.value ]]</text>
[% endfor %]
[% endif %]
[% endfor %]
</svg>
