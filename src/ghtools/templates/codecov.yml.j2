# Generated by ghtools from .github/ghtools.toml ([ci.coverage]); edit that, then run
# `ghtools codecov --write`. Defaults: https://github.com/will-roscoe/.ghtools
codecov:
  require_ci_to_pass: true
coverage:
  precision: 2
  round: down
  range: 70...95
  status:
    project:
      default:
        target: auto
        threshold: [[ threshold ]]%
    patch:
      default:
        informational: true
[% if components %]
component_management:
  default_rules:
    statuses:
      - type: project
        target: auto
        threshold: [[ threshold ]]%
  individual_components:
[% for c in components %]
    - component_id: [[ c.id ]]
      name: [[ c.name | tojson ]]
      paths:
[% for p in c.paths %]
        - [[ p | tojson ]]
[% endfor %]
[% endfor %]
[% endif %]
comment:
  layout: "header, diff, flags, [% if components %]components, [% endif %]files, footer"
  behavior: default
  require_changes: false
ignore:
  - tests/**
  - docs/**
